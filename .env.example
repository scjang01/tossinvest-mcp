TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
# Optional. Fixed account when set; otherwise each account tool requires accountSeq.
# 선택 사항. 설정하면 해당 계좌로 고정하며, 미설정 시 계좌 관련 도구마다 accountSeq를 입력해야 합니다.
TOSSINVEST_ACCOUNT=
TOSSINVEST_BASE_URL=
# Real trading remains disabled by default.
# 실제 거래는 기본적으로 비활성화됩니다.
TOSSINVEST_ENABLE_TRADING=false
# Optional positive decimal amounts, independently per native currency.
# 금액 한도는 선택 사항이며 양수로 입력합니다. 소수점을 지원하고 원화·달러별로 각각 적용합니다.
TOSSINVEST_MAX_ORDER_AMOUNT_KRW=
TOSSINVEST_MAX_ORDER_AMOUNT_USD=
# Fixed KST daily resets: KR 20:01, US 10:01; only that market's amount/count resets.
# 일일 금액·건수는 KST 고정 시각인 국내 20:01, 미국 10:01에 해당 시장분만 초기화합니다. 건수 상한도 국내·미국별로 각각 적용합니다.
TOSSINVEST_DAILY_MAX_ORDER_AMOUNT_KRW=
TOSSINVEST_DAILY_MAX_ORDER_AMOUNT_USD=
# Optional positive integer counts, separately per account and market. Unset means no count cap for that market.
# 건수 한도는 선택 사항이며 양의 정수입니다. 계좌·시장별로 적용하고, 미설정한 시장은 건수 제한이 없습니다.
TOSSINVEST_DAILY_MAX_ORDER_COUNT_KRW=
TOSSINVEST_DAILY_MAX_ORDER_COUNT_USD=
TOSSINVEST_ALLOWED_SYMBOLS=
# Both markets: lastPrice * (1 + p/100) for BUY, (1 - p/100) for SELL; 0 <= p < 100.
# 국내·미국 공통: 직전 체결가(lastPrice)에 매수는 (1 + p/100), 매도는 (1 - p/100)을 곱합니다. 범위: 0 <= p < 100.
TOSSINVEST_MARKET_ORDER_BUFFER_PCT=3
# Share this directory across processes using the same API key. Defaults to OS data directory.
# 같은 API 키를 사용하는 프로세스는 이 디렉터리를 공유해야 합니다. 미설정 시 운영체제별 기본 데이터 경로를 사용합니다.
TOSSINVEST_DATA_DIR=
# Optional legacy state path / new state filename prefix. Use the same value across processes.
# 선택 사항. 기존 상태 파일 경로이자 새 상태 파일명의 접두사입니다. 같은 API 키의 프로세스는 동일한 값을 사용해야 합니다.
TOSSINVEST_GUARD_STATE_PATH=
